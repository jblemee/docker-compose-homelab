# =============================================================================
# Docker Compose Homelab - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git (it contains secrets)
# =============================================================================

# === REQUIRED ===
# Your domain name (all services will be subdomains of this)
DOMAIN=example.com

# Email for Let's Encrypt SSL certificates
LETSENCRYPT_EMAIL=admin@example.com

# === USER PERMISSIONS ===
# UID/GID for file ownership (run 'id' to find yours)
PUID=1000
PGID=1000

# Timezone (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Paris

# === OVH DNS (optional - for automatic DNS management) ===
# Create token at: https://eu.api.ovh.com/createToken/
# Required permissions: GET/POST/PUT/DELETE /domain/zone/*
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# =============================================================================
# Per-service variables
# =============================================================================
# Each services/<name>.yml documents the variables it needs in its header.
# Below are the ones required by the bundled example service (peertube.yml);
# delete this block if you remove that service.

# === PEERTUBE (services/peertube.yml) ===
POSTGRES_USER=peertube
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=peertube

PEERTUBE_ADMIN_EMAIL=admin@example.com
# Generate with: openssl rand -hex 32
PEERTUBE_SECRET=changeme_secret_32chars_minimum

PEERTUBE_SMTP_HOSTNAME=peertube-postfix
PEERTUBE_SMTP_PORT=25
PEERTUBE_SMTP_FROM=noreply@example.com
