[Unit]
Description=Docker DOCKER-USER firewall rules
# Docker flushes and rebuilds its chains on start, so these rules must be
# (re)applied afterwards or they are silently lost.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/docker-user-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
